# Required to run workflows.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agent-workflows
API_PORT=3001
# Where saved flows are stored (default: apps/server/data/flows.json)
FLOWS_FILE=
